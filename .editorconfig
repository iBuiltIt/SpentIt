root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cmake,json}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

# Markdown trailing spaces may encode intentional hard line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Upstream currency snapshots are hashed evidence, not editable source.
[third_party/iso4217/*.xml]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
