{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {
      "name": "app-release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/import-ui-rules-release",
      "cacheVariables": {
        "SPENTIT_STORAGE_PROTOTYPE": "ON",
        "SPENTIT_IMPORT_WORKFLOW": "ON",
        "SPENTIT_IMPORT_UI": "ON",
        "SPENTIT_RULES": "ON",
        "SPENTIT_DIAGNOSTICS": "ON",
        "SPENTIT_SQLCIPHER_SOURCE": "${sourceDir}/build/dependencies/sqlcipher-build",
        "SPENTIT_APPLICATION_OUTPUT_DIRECTORY": "${sourceDir}/build"
      }
    },
    {"name": "sanitized", "inherits": "debug", "binaryDir": "${sourceDir}/build/sanitized", "cacheVariables": {"SPENTIT_SANITIZERS": "ON"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "app-release", "configurePreset": "app-release"},
    {"name": "sanitized", "configurePreset": "sanitized"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "app-release", "configurePreset": "app-release", "output": {"outputOnFailure": true}, "execution": {"jobs": 4}},
    {"name": "sanitized", "configurePreset": "sanitized", "output": {"outputOnFailure": true}}
  ]
}
