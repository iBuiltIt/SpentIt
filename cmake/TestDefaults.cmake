# Called at the end of each directory that owns CTest registrations.
function(spentit_test_defaults)
  get_property(tests DIRECTORY PROPERTY TESTS)
  foreach(test IN LISTS tests)
    get_property(timeout TEST "${test}" PROPERTY TIMEOUT SET)
    if(NOT timeout)
      set_tests_properties("${test}" PROPERTIES TIMEOUT 180)
    endif()
    get_property(labels TEST "${test}" PROPERTY LABELS SET)
    if(NOT labels)
      if(test MATCHES "faults|(^|[._])(io|crashes|boundaries)$|^accounts\\.combined|^import\\.(acceptance_order|incomplete_cleanup)$")
        set_tests_properties("${test}" PROPERTIES LABELS durability)
      else()
        set_tests_properties("${test}" PROPERTIES LABELS core)
      endif()
    endif()
  endforeach()
endfunction()
