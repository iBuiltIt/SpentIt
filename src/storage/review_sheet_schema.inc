constexpr const char* review_sheet_schema=R"SQL(
CREATE TABLE link_exclusion_events(operation TEXT PRIMARY KEY,sequence INTEGER NOT NULL UNIQUE,identity TEXT NOT NULL,field TEXT NOT NULL CHECK(field IN('payee','memo')),expression TEXT NOT NULL,account INTEGER NOT NULL CHECK(account>=0),regex INTEGER NOT NULL CHECK(regex IN(0,1)),removed INTEGER NOT NULL CHECK(removed IN(0,1)),generation INTEGER NOT NULL) STRICT;
CREATE INDEX link_exclusion_identity ON link_exclusion_events(identity,sequence);
CREATE TRIGGER register_link_exclusion BEFORE INSERT ON link_exclusion_events BEGIN INSERT INTO operation_registry VALUES(NEW.operation,6); END;
CREATE TRIGGER link_exclusion_immutable BEFORE UPDATE ON link_exclusion_events BEGIN SELECT RAISE(ABORT,'Link exclusion history is immutable'); END;
CREATE TRIGGER link_exclusion_keep BEFORE DELETE ON link_exclusion_events BEGIN SELECT RAISE(ABORT,'Link exclusion history is retained'); END;
CREATE TABLE review_answers(id TEXT PRIMARY KEY,sequence INTEGER NOT NULL UNIQUE CHECK(sequence>0),action INTEGER NOT NULL CHECK(action BETWEEN 0 AND 4),question TEXT NOT NULL,request TEXT NOT NULL,generation INTEGER NOT NULL CHECK(generation>=0)) STRICT;
CREATE TABLE review_undos(id TEXT PRIMARY KEY,answer TEXT NOT NULL UNIQUE REFERENCES review_answers(id)) STRICT;
CREATE TABLE review_undo_members(undo_id TEXT NOT NULL REFERENCES review_undos(id),child TEXT PRIMARY KEY REFERENCES ledger_operations(id),original_child TEXT NOT NULL REFERENCES ledger_operations(id)) STRICT;
CREATE TABLE review_stack(answer TEXT PRIMARY KEY REFERENCES review_answers(id),generation INTEGER NOT NULL CHECK(generation>=0)) STRICT;
CREATE TABLE review_members(answer TEXT NOT NULL REFERENCES review_answers(id),batch TEXT NOT NULL,ordinal INTEGER NOT NULL,committed INTEGER NOT NULL CHECK(committed IN(0,1)),prior INTEGER NOT NULL,result INTEGER NOT NULL,child TEXT NOT NULL,PRIMARY KEY(answer,batch,ordinal)) STRICT;
CREATE TABLE review_choices(answer TEXT NOT NULL REFERENCES review_answers(id),kind INTEGER NOT NULL CHECK(kind IN(0,1)),batch TEXT NOT NULL,ordinal INTEGER NOT NULL,resolved INTEGER NOT NULL CHECK(resolved IN(0,1)),PRIMARY KEY(answer,kind,batch,ordinal)) STRICT;
CREATE INDEX review_choice_identity ON review_choices(kind,batch,ordinal,answer);
CREATE TABLE review_sources(answer TEXT NOT NULL REFERENCES review_answers(id),source_batch TEXT NOT NULL,source_ordinal INTEGER NOT NULL,prior_batch TEXT NOT NULL,prior_ordinal INTEGER NOT NULL,result_batch TEXT NOT NULL,result_ordinal INTEGER NOT NULL,PRIMARY KEY(answer,source_batch,source_ordinal)) STRICT;
CREATE TABLE review_merges(batch TEXT NOT NULL,ordinal INTEGER NOT NULL,target_batch TEXT NOT NULL,target_ordinal INTEGER NOT NULL,answer TEXT NOT NULL REFERENCES review_answers(id),PRIMARY KEY(batch,ordinal)) STRICT;
CREATE TABLE review_link_history(answer TEXT NOT NULL REFERENCES review_answers(id),identity TEXT NOT NULL,prior_payload BLOB,result_payload BLOB NOT NULL,operation TEXT NOT NULL,PRIMARY KEY(answer,identity)) STRICT;
CREATE TRIGGER review_answers_immutable BEFORE UPDATE ON review_answers BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_answers_keep BEFORE DELETE ON review_answers BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
CREATE TRIGGER review_undos_immutable BEFORE UPDATE ON review_undos BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_undos_keep BEFORE DELETE ON review_undos BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
CREATE TRIGGER review_members_immutable BEFORE UPDATE ON review_members BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_members_keep BEFORE DELETE ON review_members WHEN spentit_cleanup()=0 BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
CREATE TRIGGER review_choices_immutable BEFORE UPDATE ON review_choices BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_choices_keep BEFORE DELETE ON review_choices WHEN spentit_cleanup()=0 BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
CREATE TRIGGER review_sources_immutable BEFORE UPDATE ON review_sources BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_sources_keep BEFORE DELETE ON review_sources WHEN spentit_cleanup()=0 BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
CREATE TRIGGER review_link_history_immutable BEFORE UPDATE ON review_link_history BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_link_history_keep BEFORE DELETE ON review_link_history WHEN spentit_cleanup()=0 BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
CREATE TRIGGER review_answer_collision BEFORE INSERT ON review_answers WHEN EXISTS(SELECT 1 FROM operation_registry WHERE id=NEW.id) OR EXISTS(SELECT 1 FROM review_undos WHERE id=NEW.id) OR EXISTS(SELECT 1 FROM dataset_acceptances WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'Operation identity belongs to another command'); END;
CREATE TRIGGER review_undo_collision BEFORE INSERT ON review_undos WHEN EXISTS(SELECT 1 FROM operation_registry WHERE id=NEW.id) OR EXISTS(SELECT 1 FROM review_answers WHERE id=NEW.id) OR EXISTS(SELECT 1 FROM dataset_acceptances WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'Operation identity belongs to another command'); END;
CREATE TRIGGER registry_review_collision BEFORE INSERT ON operation_registry WHEN EXISTS(SELECT 1 FROM review_answers WHERE id=NEW.id) OR EXISTS(SELECT 1 FROM review_undos WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'Operation identity belongs to Review'); END;
CREATE TRIGGER acceptance_review_collision BEFORE INSERT ON dataset_acceptances WHEN EXISTS(SELECT 1 FROM review_answers WHERE id=NEW.id) OR EXISTS(SELECT 1 FROM review_undos WHERE id=NEW.id) BEGIN SELECT RAISE(ABORT,'Operation identity belongs to Review'); END;
CREATE TRIGGER review_undo_members_immutable BEFORE UPDATE ON review_undo_members BEGIN SELECT RAISE(ABORT,'Review history is immutable'); END;
CREATE TRIGGER review_undo_members_keep BEFORE DELETE ON review_undo_members BEGIN SELECT RAISE(ABORT,'Review history is retained'); END;
)SQL";
