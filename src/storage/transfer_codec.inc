// Private deterministic encoding for encrypted transfer history; never a source
// file format. Lengths and every numeric field are bounded and checked on read.
namespace transfer_codec {
struct Writer {
    std::string bytes;
    void text(std::string_view value){if(value.size()>qif::max_field)fail(SQLITE_TOOBIG);bytes+=std::to_string(value.size());bytes+=':';bytes+=value;}
    void number(std::int64_t value){text(std::to_string(value));}
    void money(const Money& value){number(value.units());text(value.currency().definition_id());}
    void endpoint(const transfers::Endpoint& value){number(value.account);text(value.entry.batch);number(integer(value.entry.ordinal));text(value.allocation);}
    void evidence(const std::optional<transfers::BankEvidence>& value){number(value?1:0);if(value){endpoint(value->endpoint);money(value->amount);text(value->posting_date);}}
    void side(const transfers::Side& value){endpoint(value.endpoint);money(value.amount);text(value.date);number(static_cast<int>(value.state));number(value.independent_evidence);number(value.provisional_date);number(value.manually_entered);number(value.accepted_unmatched);evidence(value.attached_evidence);evidence(value.proposed_evidence);number(value.ledger_entry);}
    void fact(const transfers::AllocationFact& value){endpoint(value.endpoint);money(value.amount);text(value.date);number(static_cast<int>(value.state));number(value.imported?1:0);number(value.generated?1:0);number(value.manually_entered?1:0);number(value.ledger_entry);}
};
struct Reader {
    std::string_view bytes;
    std::string text(){const auto end=bytes.find(':');if(end==bytes.npos || end==0 || end>8)fail(SQLITE_CORRUPT);std::size_t size=0;const auto parsed=std::from_chars(bytes.data(),bytes.data()+end,size);if(parsed.ec!=std::errc{} || parsed.ptr!=bytes.data()+end || size>qif::max_field || size>bytes.size()-end-1)fail(SQLITE_CORRUPT);bytes.remove_prefix(end+1);std::string out(bytes.substr(0,size));bytes.remove_prefix(size);return out;}
    std::int64_t number(){const auto value=text();std::int64_t out=0;const auto parsed=std::from_chars(value.data(),value.data()+value.size(),out);if(parsed.ec!=std::errc{} || parsed.ptr!=value.data()+value.size() || std::to_string(out)!=value)fail(SQLITE_CORRUPT);return out;}
    bool boolean(){auto n=number();if(n!=0 && n!=1)fail(SQLITE_CORRUPT);return n==1;}
    Money money(){auto units=number();return Money(units,Currency::from_definition(text()));}
    transfers::Endpoint endpoint(){auto account=number();auto batch=text();auto ordinal=number();if(ordinal<0 || ordinal>=static_cast<std::int64_t>(qif::max_records))fail(SQLITE_CORRUPT);return {account,{batch,static_cast<std::size_t>(ordinal)},text()};}
    std::optional<transfers::BankEvidence> evidence(){if(!boolean())return {};auto id=endpoint();auto value=money();return transfers::BankEvidence{id,value,text()};}
    transfers::Side side(){auto id=endpoint();auto amount=money();auto date=text();const auto state=number();if(state<0 || state>2)fail(SQLITE_CORRUPT);transfers::Side out{id,amount,date,static_cast<transfers::State>(state)};out.independent_evidence=boolean();out.provisional_date=boolean();out.manually_entered=boolean();out.accepted_unmatched=boolean();out.attached_evidence=evidence();out.proposed_evidence=evidence();out.ledger_entry=boolean();return out;}
    transfers::AllocationFact fact(){auto id=endpoint();auto amount=money();auto date=text();const auto state=number();if(state<0 || state>1)fail(SQLITE_CORRUPT);transfers::AllocationFact out{id,amount,date,static_cast<transfers::State>(state)};out.imported=boolean();out.generated=boolean();out.manually_entered=boolean();out.ledger_entry=boolean();return out;}
    void finish(){if(!bytes.empty())fail(SQLITE_CORRUPT);}
};
std::string encode(const app::TransferView& value){Writer out;out.text(value.link.identity);out.side(value.link.origin);out.side(value.link.destination);out.text(value.link.generated_date);out.text(value.payee);out.text(value.memo);out.number(value.created_sequence);out.number(value.link.preserved_amounts?1:0);const bool dated=value.link.origin_date_corrected,released=value.link.destination_released,categorized=!value.link.origin_category.empty();if(value.link.unresolved || dated || released || categorized){out.number(value.link.unresolved?1:0);if(dated || released || categorized){out.number(dated?1:0);out.number(released?1:0);out.number(categorized?1:0);if(categorized)out.text(value.link.origin_category);}}return out.bytes;}
app::TransferView view(std::string_view bytes){Reader in{bytes};auto id=in.text();auto origin=in.side();auto destination=in.side();auto date=in.text();auto payee=in.text();auto memo=in.text();auto sequence=in.number();const auto preserved=in.boolean();bool unresolved=false,dated=false,released=false;std::string category;if(!in.bytes.empty()){unresolved=in.boolean();if(!in.bytes.empty()){dated=in.boolean();released=in.boolean();if(in.boolean())category=in.text();}}in.finish();app::TransferView out{{id,origin,destination,date,preserved,unresolved,dated,released,std::move(category)},payee,memo,sequence};transfers::validate(out.link);safe_text(payee);safe_text(memo);if(sequence<=0)fail(SQLITE_CORRUPT);return out;}
std::string encode(const app::TransferRequest& value){Writer out;out.number(static_cast<int>(value.action));out.text(value.link);out.number(value.expected_sequence);out.number(value.origin?1:0);if(value.origin){out.text(value.origin->batch);out.number(integer(value.origin->ordinal));}out.text(value.allocation);out.number(value.batch_revision);out.number(value.destination);out.number(value.amount?1:0);if(value.amount)out.money(*value.amount);out.text(value.date);out.text(value.payee);out.text(value.memo);out.evidence(value.evidence);if(value.action==app::TransferAction::merge || value.action==app::TransferAction::retarget){out.text(value.kept);out.number(value.mode);out.text(value.category_id);out.text(value.category_path);out.number(value.generated?1:0);if(value.generated)out.endpoint(*value.generated);out.text(value.generated_currency);out.number(value.left?1:0);if(value.left)out.fact(*value.left);out.number(value.right?1:0);if(value.right)out.fact(*value.right);out.number(value.right_revision);out.number(value.category_generation);}return out.bytes;}
app::TransferRequest request(std::string_view bytes){Reader in{bytes};auto action=in.number();if(action<0 || action>16)fail(SQLITE_CORRUPT);app::TransferRequest out{};out.action=static_cast<app::TransferAction>(action);out.link=in.text();out.expected_sequence=in.number();if(in.boolean()){auto batch=in.text();auto ordinal=in.number();if(ordinal<0 || ordinal>=static_cast<std::int64_t>(qif::max_records))fail(SQLITE_CORRUPT);out.origin=imports::Occurrence{batch,static_cast<std::size_t>(ordinal)};}out.allocation=in.text();out.batch_revision=in.number();out.destination=in.number();if(in.boolean())out.amount=in.money();out.date=in.text();out.payee=in.text();out.memo=in.text();out.evidence=in.evidence();if(action==9 || action==10){out.kept=in.text();out.mode=static_cast<int>(in.number());if(out.mode!=0 && out.mode!=1)fail(SQLITE_CORRUPT);out.category_id=in.text();out.category_path=in.text();if(in.boolean())out.generated=in.endpoint();out.generated_currency=in.text();if(in.boolean())out.left=in.fact();if(in.boolean())out.right=in.fact();out.right_revision=in.number();out.category_generation=in.number();}in.finish();return out;}
}
